    {
      "name": "00 - Authentication & Role Logins",
      "description": "OAuth2 Authorization Server endpoints for issuing JWT Access Tokens & End-User Role Authentication (REQUESTER, MANAGER, VENDOR).",
      "item": [
        {
          "name": "POST Get OAuth2 Access Token (Client Credentials)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set(\"access_token\", jsonData.access_token);",
                  "    console.log(\"OAuth2 client token saved: \" + jsonData.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{client_id}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{client_secret}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "read write",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{gateway_url}}/oauth2/token",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "oauth2",
                "token"
              ]
            }
          }
        },
        {
          "name": "POST Login REQUESTER (Staff Pengadaan)",
